# Stage 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Отключаем телеметрию во время билда
ENV NEXT_TELEMETRY_DISABLED=1

# Build-time args for NEXT_PUBLIC_* variables (embedded at build time)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BOT_URL
ARG NEXT_PUBLIC_VK_BOT_URL
ARG NEXT_PUBLIC_FINGERPRINT_MODE
ARG FRONTEND_FINGERPRINT_MODE

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_BOT_URL=$NEXT_PUBLIC_BOT_URL
ENV NEXT_PUBLIC_VK_BOT_URL=$NEXT_PUBLIC_VK_BOT_URL
ENV NEXT_PUBLIC_FINGERPRINT_MODE=$NEXT_PUBLIC_FINGERPRINT_MODE
ENV FRONTEND_FINGERPRINT_MODE=$FRONTEND_FINGERPRINT_MODE

# Собираем проект
RUN npm run build

# Stage 3: Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_FINGERPRINT_MODE=""
ENV FRONTEND_FINGERPRINT_MODE=""

# Создаем пользователя
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем public (картинки и т.д.)
COPY --from=builder /app/public ./public

# Копируем оптимизированную сборку (standalone)
# Автоматически создается Next.js, если включен output: 'standalone'
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
