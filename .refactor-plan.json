{
  "workflow": "structure-refactoring",
  "phase": "planning",
  "config": {
    "order": [
      "backend-attachments",
      "frontend-attachments-hook"
    ],
    "batchSize": 1,
    "importUpdateStrategy": "automatic",
    "currentStructure": {
      "backend-attachments": [
        "backend/app/api/v1/endpoints/feedback.py"
      ],
      "frontend-attachments-hook": [
        "frontend/src/components/feedback/hooks/useAttachments.ts"
      ]
    },
    "targetStructure": {
      "backend-attachments": {
        "extractEndpointsTo": "backend/app/api/v1/endpoints/feedback_attachments.py",
        "serviceLayerOption": "backend/app/services/feedback/attachments.py",
        "keepInFeedbackFile": [
          "POST /feedback",
          "GET /feedback",
          "PATCH /feedback/{id}",
          "GET /feedback/count/new"
        ],
        "moveEndpoints": [
          "POST /attachments",
          "POST /attachments/{id}/presign",
          "PUT /attachments/{id}/mark-uploaded",
          "GET /attachments/{id}/url",
          "DELETE /attachments/{id}"
        ],
        "notes": [
          "feedback.py is >320 LOC (500+); split attachment endpoints first, then refactor",
          "preserve logging and type safety; ensure dependencies injected cleanly",
          "update router registrations and imports after move",
          "consider service extraction if endpoint logic heavy"
        ]
      },
      "frontend-attachments-hook": {
        "unifyFunction": "uploadOrRetryAttachment",
        "replace": [
          "uploadAttachment",
          "retryAttachment"
        ],
        "requirements": [
          "single reusable logic handles new upload or retry given attachment_id",
          "preserve type safety and existing logging/analytics hooks"
        ]
      }
    }
  },
  "validation": {
    "required": [
      "backend: pytest backend -q",
      "frontend: pnpm lint --filter frontend",
      "frontend: pnpm test --filter frontend -- --runInBand"
    ],
    "optional": [
      "frontend: pnpm type-check --filter frontend"
    ]
  },
  "qa": {
    "sequence": [
      "@test-automator",
      "@code-reviewer",
      "@documentarist"
    ]
  },
  "reporting": {
    "reportChangedFiles": true,
    "postRefactorNote": "List all modified files after refactor."
  }
}
