#!/bin/sh

echo "🔍 Pre-commit checks..."

# Frontend: TypeScript
echo "→ Frontend: TypeScript check"
cd frontend && npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix before committing."
  exit 1
fi
cd ..

# Backend: Ruff (только изменённые файлы)
BACKEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^backend/.*\.py$" || true)
if [ -n "$BACKEND_FILES" ]; then
  echo "→ Backend: Ruff lint"
  # Пробуем ruff из Docker, если нет локально
  if command -v ruff &> /dev/null; then
    echo "$BACKEND_FILES" | xargs ruff check --fix
  elif docker ps --format '{{.Names}}' | grep -q edu-backend; then
    docker exec edu-backend ruff check --fix $(echo "$BACKEND_FILES" | sed 's|backend/|/app/|g')
  else
    echo "⚠️ ruff not available, skipping backend lint"
  fi
fi

echo "✅ Pre-commit checks passed"
