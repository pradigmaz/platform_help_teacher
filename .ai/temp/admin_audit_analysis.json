    "backend_files": [
      {
        "path": "backend/app/api/v1/endpoints/admin_audit.py",
        "lines": 372,
        "type": "fastapi_router",
        "purpose": "Admin Audit API: просмотр логов (список/деталь), статистика, предпросмотр и удаление логов по фильтрам.",
        "provides": ["router: APIRouter"],
        "auth": { "dependency": "app.api.deps.get_current_active_superuser", "scope": "all endpoints" },
        "endpoints_served": [
          {
            "method": "GET",
            "path": "/admin/audit",
            "name": "get_audit_logs",
            "rate_limit": "30/minute",
            "purpose": "Получить список логов с фильтрами и пагинацией; добавляет suspicion для анонимных запросов.",
            "query": [
              "user_id: UUID?",
              "action_type: str?",
              "ip_address: str? (ilike %...%)",
              "date_from: datetime?",
              "date_to: datetime?",
              "path_contains: str? (ilike %...%)",
              "skip: int (>=0)",
              "limit: int (1..100)"
            ],
            "response_model": "AuditLogListResponse"
          },
          {
            "method": "GET",
            "path": "/admin/audit/{log_id}",
            "name": "get_audit_log_detail",
            "rate_limit": "60/minute",
            "purpose": "Детали одной записи аудита (включая query_params, request_body, extra_data).",
            "query": [],
            "response_model": "AuditLogResponse"
          },
          {
            "method": "GET",
            "path": "/admin/audit/user/{user_id}",
            "name": "get_user_audit_logs",
            "rate_limit": "30/minute",
            "purpose": "Шорткат для логов конкретного пользователя (делегирует в get_audit_logs).",
            "query": ["skip", "limit"],
            "response_model": "AuditLogListResponse"
          },
          {
            "method": "GET",
