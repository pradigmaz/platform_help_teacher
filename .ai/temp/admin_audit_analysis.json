      "included_paths": [
        "frontend/src/app/admin/audit/*",
        "frontend/src/app/admin/audit/components/*",
        "backend/app/api/v1/endpoints/admin_audit.py",
        "backend/app/api/v1/endpoints/admin_audit_export.py",
        "backend/app/services/audit/*"
