    "backend_files": [
      {
        "path": "backend/app/api/v1/endpoints/student/labs.py",
        "lines": 409,
        "domain": "student",
        "purpose": "FastAPI эндпоинты для лабораторных студента: список видимых лаб по расписанию, детали лабы, отметка готовности к сдаче (очередь) и отмена готовности.",
        "imports": [
          "fastapi (APIRouter, Depends, HTTPException, Request)",
          "sqlalchemy (select)",
          "sqlalchemy.ext.asyncio (AsyncSession)",
          "app.api.deps (get_db, get_current_user)",
          "app.models.user (User, UserRole)",
          "app.models.lab (Lab)",
          "app.models.submission (Submission, SubmissionStatus)",
          "app.audit (audit_action, audit_user, ActionType, EntityType)",
          "app.services.lab_visibility (LabVisibilityService)",
          "app.core.limiter (limiter)",
          "typing/uuid/datetime"
        ],
        "provides": {
          "router": "APIRouter()",
          "endpoints": [
            {
              "method": "GET",
              "path": "/labs (mounted under /student => /student/labs)",
              "handler": "get_my_labs",
              "returns": "list[dict]",
              "notes": [
                "Фильтрация видимых лаб по расписанию (LabVisibilityService.get_visible_lab_numbers_by_subject)",
                "Поле is_available рассчитывается локально по prev_accepted (последовательность)"
              ]
            },
            {
              "method": "GET",
              "path": "/labs/{lab_id} (=> /student/labs/{lab_id})",
              "handler": "get_lab_detail",
              "returns": "dict",
              "notes": [
                "Проверка видимости по расписанию через LabVisibilityService.get_visibility_info",
                "Добавляет can_submit_now (идёт ли пара)"
              ]
            },
            {
              "method": "POST",
              "path": "/labs/{lab_id}/ready (=> /student/labs/{lab_id}/ready)",
              "handler": "mark_lab_ready",
              "rate_limit": "10/hour",
              "returns": "{ status, submission_id, variant_number, message }",
              "notes": [
                "Доступно только во время пары (is_lab_session_now)",
                "Выставляет Submission.status=READY и ready_at"
              ]
            },
            {
              "method": "POST",
              "path": "/labs/{lab_id}/cancel-ready (=> /student/labs/{lab_id}/cancel-ready)",
              "handler": "cancel_lab_ready",
              "returns": "{ status, message }",
              "notes": [
                "Переводит READY -> NEW, чистит ready_at"
              ]
            }
          ],
          "helpers": [
            "_format_submission(sub)",
            "_get_student_position(db, user)",
            "_check_lab_availability(db, user_id, lab)"
          ]
        },
        "serves_api_for": [
          "frontend StudentAPI.getLabs/getLabDetail/markLabReady/cancelLabReady"
        ],
        "notes": [
          "В get_my_labs реализована batch-загрузка visibility info, чтобы избежать N+1.",
          "variant_number считается как позиция студента в группе (по full_name) % variants_count.",
          "Явного логирования нет, но есть audit_action/audit_user (возможно, закрывает аудит/логирование действий)."
        ],
        "risks": [
