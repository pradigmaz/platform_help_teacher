            "items": ["send_announcement_to_students"]
          }
        ],
        "auth": {
          "dependency": "deps.get_current_active_superuser",
          "scope": "applies_to_all_endpoints"
        },
        "endpoints_served": [
          {
            "method": "GET",
            "path": "/",
            "function": "get_announcements",
            "response_model": "List[AnnouncementListResponse]",
            "purpose": "Получить список всех объявлений (черновики + опубликованные)",
            "notes": ["Поддерживает skip/limit (дефолт: 0/100)"]
          },
          {
            "method": "POST",
            "path": "/",
            "function": "create_announcement",
            "response_model": "AnnouncementResponse",
            "purpose": "Создать черновик объявления",
            "notes": [
              "Создаёт запись через crud_announcement.create(..., created_by=current_user.id)",
              "Затем перечитывает через crud_announcement.get(...) для подгрузки автора (author_name)"
            ]
          },
          {
            "method": "GET",
            "path": "/{announcement_id}",
            "function": "get_announcement",
            "response_model": "AnnouncementResponse",
            "purpose": "Получить объявление по ID",
            "notes": ["404 если не найдено"]
          },
          {
            "method": "PUT",
            "path": "/{announcement_id}",
            "function": "update_announcement",
            "response_model": "AnnouncementResponse",
            "purpose": "Обновить объявление",
            "notes": ["404 если не найдено"]
          },
          {
            "method": "DELETE",
            "path": "/{announcement_id}",
            "function": "delete_announcement",
            "response_model": null,
            "purpose": "Удалить объявление",
            "notes": ["Возвращает {status: 'deleted'} или 404"]
          },
          {
            "method": "POST",
            "path": "/{announcement_id}/publish",
            "function": "publish_announcement",
            "response_model": "AnnouncementResponse",
            "purpose": "Опубликовать черновик",
            "notes": ["400 если уже опубликовано", "404 если не найдено"]
          },
          {
            "method": "POST",
            "path": "/{announcement_id}/send",
            "function": "send_announcement",
            "response_model": null,
            "purpose": "Отправить опубликованное объявление студентам через ботов",
            "notes": [
              "400 если announcement.is_draft=true",
              "Возвращает {status: 'sent', stats: <result of send_announcement_to_students>}"
            ]
          }
        ],
        "notes": [
          "Вспомогательная функция _to_response добавляет author_name (announcement.author.full_name) и поля дат.",
          "Отсутствует явное логирование операций publish/send."
