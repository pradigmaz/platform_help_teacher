      "frontend_to_backend_contract": {
        "admin_announcements_router_prefix": "/admin/announcements",
        "mapping": [
          {
            "frontend_call": "api.get('/admin/announcements')",
            "backend": "GET / (get_announcements)"
          },
          {
            "frontend_call": "api.post('/admin/announcements', {title, content})",
            "backend": "POST / (create_announcement)"
          },
          {
            "frontend_call": "api.get(`/admin/announcements/${id}`)",
            "backend": "GET /{announcement_id} (get_announcement)"
          },
          {
            "frontend_call": "api.put(`/admin/announcements/${id}`, {title, content})",
            "backend": "PUT /{announcement_id} (update_announcement)"
          },
          {
            "frontend_call": "api.delete(`/admin/announcements/${id}`)",
            "backend": "DELETE /{announcement_id} (delete_announcement)"
          },
          {
            "frontend_call": "api.post(`/admin/announcements/${id}/publish`)",
            "backend": "POST /{announcement_id}/publish (publish_announcement)"
          },
          {
            "frontend_call": "api.post(`/admin/announcements/${id}/send`)",
            "backend": "POST /{announcement_id}/send (send_announcement)"
          }
        ],
        "notes": [
          "В backend этот роутер включён с prefix='/admin/announcements' в backend/app/api/v1/api.py; полный URL также зависит от общего prefix версии API (обычно /api/v1), который задаётся на уровне приложения.",
          "В backend маршруты объявлены с path='/' (со слешем); фронтенд использует без завершающего слеша — возможен 307 redirect (зависит от redirect_slashes)."
        ]
      }
