{
  "system": "edu-platform",
  "domain": "labs",
  "analysis_date": "2024-12-19",
  "components": {
    "backend": {
      "models": {
        "Lab": {
          "fields": ["id", "title", "description", "work_number", "is_published", "created_at"],
          "relationships": ["submissions", "settings", "deadlines"],
          "features": ["soft_delete", "audit_log", "version_control"]
        },
        "Submission": {
          "fields": ["id", "student_id", "lab_id", "status", "queue_position", "submitted_at"],
          "statuses": ["NEW", "READY", "IN_PROGRESS", "ACCEPTED", "REJECTED"],
          "constraints": ["unique_active_submission", "sequential_completion"]
        },
        "LabSettings": {
          "fields": ["lab_id", "deadline_lessons", "variant_assignment", "max_score", "auto_variants"],
          "logic": ["deadline_calculation", "variant_distribution", "score_degradation"]
        },
        "WorkSubmission": {
          "fields": ["id", "submission_id", "score", "feedback", "graded_by", "graded_at"],
          "features": ["detailed_feedback", "score_history", "resubmission_tracking"]
        }
      },
      "api": {
        "admin_endpoints": {
          "path": "/api/v1/admin/labs",
          "operations": ["CRUD", "batch_operations", "queue_management", "statistics"],
          "permissions": ["ADMIN", "TEACHER"]
        },
        "student_endpoints": {
          "path": "/api/v1/student/labs",
          "operations": ["list_available", "get_details", "submit", "check_queue"],
          "rate_limits": "10_submissions_per_hour"
        }
      },
      "services": {
        "lab_visibility": {
          "functions": ["calculate_deadlines", "check_availability", "assign_variants"],
          "caching": "redis_60min",
          "optimization": "batch_queries"
        },
        "queue_management": {
          "algorithm": "FIFO",
          "constraints": ["lesson_time_only", "sequential_completion"],
          "notifications": "real_time_updates"
        }
      }
    },
    "frontend": {
      "admin_pages": {
        "labs_list": {
          "path": "/admin/labs",
          "features": ["filtering", "sorting", "batch_actions", "statistics_overview"]
        },
        "lab_editor": {
          "path": "/admin/labs/[id]/edit",
          "tabs": ["header", "theory", "practice", "questions"],
          "editor": "lexical",
          "validation": "react_hook_form_zod"
        }
      },
      "student_pages": {
        "dashboard": {
          "path": "/dashboard/labs",
          "features": ["progress_map", "status_filters", "deadline_alerts"],
          "ui": "card_grid_layout"
        },
        "lab_detail": {
          "path": "/labs/[id]",
          "sections": ["objective", "theory", "practice", "variant", "questions"],
          "actions": ["submit_for_review", "join_queue", "check_status"]
        }
      }
    },
    "business_logic": {
      "deadline_system": {
        "base_calculation": "current_lesson + N_lessons",
        "extensions": "LabDeadlineExtension_model",
        "score_degradation": [5, 4, 3],
        "group_overrides": "supported"
      },
      "variant_assignment": {
        "algorithm": "student_position % variants_count",
        "auto_generation": "enabled",
        "manual_override": "admin_only"
      },
      "submission_flow": {
        "type": "oral_defense_only",
        "medium": "notebook_based",
        "queue": "FIFO_during_lessons",
        "restrictions": ["lesson_time", "sequential_order", "rate_limit"]
      }
    },
    "integrations": {
      "schedule": {
        "connection": "work_number_mapping",
        "availability": "lesson_time_only",
        "notifications": "lesson_start_alerts"
      },
      "redis": {
        "caching": ["lab_visibility", "queue_status", "student_progress"],
        "rate_limiting": "submission_attempts",
        "session_management": "queue_positions"
      }
    }
  },
  "key_features": [
    "auto_variant_assignment",
    "batch_optimization",
    "soft_delete_history",
    "redis_caching",
    "schedule_integration",
    "fifo_queue_system",
    "flexible_deadlines",
    "oral_defense_workflow"
  ],
  "constraints": [
    "no_file_uploads",
    "lesson_time_only",
    "sequential_completion",
    "rate_limit_10_per_hour",
    "teacher_ownership"
  ]
}