{
  "title": "Процесс сдачи лабораторных работ и выставления оценок",
  "project": "platforma_maga",
  "stack": {
    "backend": "FastAPI + SQLAlchemy",
    "frontend": "Next.js 16 + React 19"
  },
  "backend": {
    "models": {
      "Submission": {
        "fields": [
          "user_id", "lab_id", "status", "variant_number", "s3_key", 
          "is_manual", "grade", "feedback", "ready_at", "accepted_at", 
          "history", "deleted_at"
        ],
        "statuses": ["NEW", "READY", "IN_REVIEW", "REQ_CHANGES", "ACCEPTED", "REJECTED"],
        "constraints": "unique constraint",
        "relations": "user_id, lab_id"
      },
      "LessonGrade": {
        "fields": ["lesson_id", "student_id", "work_number", "grade", "comment", "created_by"],
        "grade_range": "2-5",
        "constraint": "unique (lesson_id, student_id, work_number)"
      }
    },
    "services": {
      "submission_service": {
        "methods": {
          "accept": "проверка статуса, валидация дедлайнов, обновление, history, синхронизация с журналом",
          "reject": "обновление статуса, feedback, history",
          "_validate_grade_constraints": "дедлайны, слоты",
          "_sync_with_journal": "поиск занятия, создание/обновление LessonGrade",
          "_find_lesson_for_student": "ближайшее прошедшее LAB-занятие"
        }
      }
    },
    "queue": {
      "type": "FIFO",
      "sorting": "ready_at ASC",
      "status_filter": "READY",
      "indexes": ["idx_submission_status", "idx_submission_status_ready_at"],
      "constraints": {
        "rate_limit": "10/hour",
        "time_restriction": "is_lab_session_now()",
        "sequential_completion": true,
        "visibility": "по расписанию"
      }
    },
    "grading": {
      "deadline_validation": "deadline_validator.py",
      "slot_validation": "lab_slot_validator.py (1 лаба/пара или 2 для EXCUSED)",
      "grade_degradation": "5→4→3 при просрочке"
    },
    "api_endpoints": {
      "student": {
        "POST /student/labs/{id}/ready": "rate limit 10/hour, создание Submission READY",
        "POST /cancel-ready": "READY→NEW, ready_at=null",
        "GET /labs": "список с can_submit_now",
        "GET /labs/{id}": "детали с can_submit_now"
      }
    },
    "edge_cases": {
      "debt_submission": "work_number в LessonGrade=номер сдаваемой лабы",
      "retakes": "обновление LessonGrade, слоты не проверяются при upsert",
      "excused_students": "без дедлайна, бонусный слот +1",
      "deadline_extensions": "LabDeadlineExtension, bonus_lessons"
    }
  },
  "frontend": {
    "student_ux": {
      "list_page": "/dashboard/labs",
      "features": {
        "progress_map": "X из Y работ, %",
        "filters": "Все, Не сдано, В очереди, Принято, Отклонено с счетчиками",
        "lab_cards": "статусы цветные, действия Открыть/Сдать/Отмена/Пересдать",
        "actions": "StudentAPI.markLabReady()/cancelLabReady()"
      },
      "detail_page": "/dashboard/labs/[id]",
      "structure": {
        "status_card": "с feedback",
        "content": "цель, оформление, теория Lexical, практика Lexical",
        "variant": "персональный",
        "questions": "контрольные",
        "main_button": "NEW→'Готов сдать', READY→'Выйти из очереди', REJECTED→'Исправил, сдать снова'",
        "restrictions": "can_submit_now проверка времени пары"
      }
    },
    "teacher_ux": {
      "admin_page": "/admin/labs",
      "features": {
        "statistics": "карточки с прогрессом",
        "queue_button": "открывает QueueDialog",
        "labs_table": "таблица лаб"
      },
      "queue_dialog": {
        "header": "заголовок с счетчиком",
        "refresh_button": true,
        "grouping": "по лабам (каждая лаба=карточка)",
        "student_list": "student_name, group_name, variant_number, ready_at",
        "interaction": "клик по студенту→загрузка SubmissionDetail→показ вопросов→кнопки Принять/Отклонить"
      },
      "grade_dialog": {
        "grade_selection": "кнопки 2,3,4,5 с учетом max_allowed_grade",
        "comment": "необязательный feedback",
        "deadline_warning": "предупреждение при просрочке"
      },
      "reject_dialog": {
        "comment": "обязательный комментарий (причина отклонения)",
        "validation": "кнопка неактивна без комментария"
      }
    },
    "api_methods": {
      "StudentAPI": {
        "markLabReady": "labId → {status, submission_id, variant_number?, message}",
        "cancelLabReady": "labId → {status, message}"
      },
      "LabQueueAPI": {
        "getQueue": "→ LabQueue[]",
        "getSubmissionDetail": "submissionId → SubmissionDetail",
        "acceptSubmission": "submissionId, {grade, comment}",
        "rejectSubmission": "submissionId, {comment}"
      }
    },
    "typescript_types": {
      "SubmissionStatus": "'NEW'|'READY'|'IN_REVIEW'|'ACCEPTED'|'REJECTED'",
      "StudentLabSubmission": "id, status, grade?, feedback?, ready_at?, accepted_at?",
      "SubmissionDetail": "submission_id, student_name, group_name, lab_number, variant_number?, variant_data?, questions?, max_allowed_grade"
    },
    "error_handling": {
      "common_errors": ["clock skew", "CSRF", "rate limit", "уже в очереди", "не время пары", "нет варианта"],
      "ux": "toast уведомления, показ err.response?.data?.detail, блокировка кнопок actionLoading, автообновление после успеха"
    },
    "ui_components": {
      "status_badges": "ACCEPTED green, READY yellow, REJECTED red, NEW blue, locked gray",
      "animations": "Motion/Framer для карточек, hover эффекты, loading спиннеры, skeleton",
      "responsive": "responsive grid 1-3 колонки, scroll areas в диалогах, компактные кнопки на мобиле"
    }
  },
  "full_flow": [
    "Студент нажимает 'Готов сдать'",
    "проверка can_submit_now",
    "Submission NEW→READY+ready_at",
    "очередь FIFO",
    "преподаватель открывает QueueDialog",
    "кликает студента",
    "загрузка SubmissionDetail",
    "задает вопросы",
    "accept() или reject()",
    "валидация дедлайнов/слотов",
    "Submission READY→ACCEPTED/REJECTED+grade+feedback+accepted_at",
    "_sync_with_journal()",
    "создание/обновление LessonGrade (lesson_id=текущее занятие, work_number=lab.number)",
    "оценка в журнале",
    "студент видит результат"
  ],
  "key_features": [
    "FIFO очередь по ready_at",
    "устная сдача без файлов (is_manual)",
    "валидация дедлайнов влияет на max_allowed_grade (5→4→3)",
    "слоты ограничивают 1 лаба/пара (2 для EXCUSED)",
    "сдача долгов возможна (work_number может != lesson.work_number)",
    "пересдачи через upsert LessonGrade",
    "history в Submission.history",
    "rate limit 10/час",
    "только во время LAB-пар"
  ]
}