{
  "system": "lab_deadline_system",
  "description": "Система дедлайнов лабораторных работ с продлениями",
  "backend": {
    "models": {
      "LabDeadlineExtension": {
        "fields": ["id", "lab_id", "group_id", "bonus_lessons", "reason", "expires_at", "is_active", "created_by"],
        "constraints": ["UniqueConstraint(lab_id, group_id)"],
        "indexes": ["ix_lab_deadline_extension_lab_id", "ix_lab_deadline_extension_group_id"],
        "cascade": "delete on lab/group removal"
      }
    },
    "services": {
      "lab_visibility.py": {
        "algorithm": "visibility=MIN(date), activation=MAX(date), unique work_number count, extensions apply, grade reduction 5→4→3",
        "optimization": "batch by subject_id, single MIN/MAX query, batch extension loading",
        "complexity": "O(N)→O(1)"
      },
      "deadline_validator.py": {
        "logic": "EXCUSED check, index calculation, extension application, max grade return"
      },
      "lab_slot_validator.py": {
        "rules": "1 lab limit + EXCUSED bonus"
      }
    },
    "integration": {
      "schedule": {
        "connection": "work_number (Lesson.work_number, Lab.number, LessonGrade.work_number)",
        "algorithm": "lesson search, subgroup filters (NULL=all, N=specific)"
      },
      "grade_reduction": {
        "fields": ["deadline_5_lessons", "deadline_4_lessons"],
        "mechanism": "labs_after > deadline → reduction",
        "application": "submission_service.py"
      }
    },
    "extensions": {
      "creation": "POST /admin/deadline-extensions",
      "application": "_get_extension_bonus with is_active and expires_at check",
      "expiration": "automatic expires_at < now, manual is_active=False"
    },
    "edge_cases": ["subgroups", "EXCUSED status", "NULL expires_at", "debt submission", "cancelled lessons"]
  },
  "frontend": {
    "display": {
      "cards": {
        "badge": "current_max_grade",
        "footer_statuses": ["+X пар (продление)", "На 5 уже нельзя", "Ещё X пар на 5", "Последняя пара на 5"],
        "colors": "green=extension, red=expired, orange=<=1 lesson"
      }
    },
    "admin_components": {
      "button": "Продления",
      "dialog": "DeadlineExtensionsDialog",
      "form": {
        "fields": ["Select labs", "Select groups", "Input bonus 1-10", "Textarea reason"],
        "controls": ["Switch activation", "Delete button"]
      }
    },
    "types": {
      "DeadlineExtension": ["id", "lab_id", "group_id", "bonus_lessons", "reason", "expires_at", "is_active", "created_by", "timestamps", "joined_fields"],
      "StudentLab": ["deadline_5_status", "deadline_4_status", "lessons_until_deadline_5", "lessons_until_deadline_4", "has_extension", "extension_bonus", "current_max_grade", "can_submit_now"]
    },
    "api_client": {
      "methods": ["getExtensions", "createExtension", "updateExtension", "deleteExtension"],
      "filters": ["lab_id", "group_id", "is_active"]
    },
    "ux_features": ["expired extensions hidden", "detailed API errors", "accidental close protection", "delete confirmation", "loading states", "extension priority"]
  },
  "key_features": [
    "separation of concerns (backend calculates, frontend displays)",
    "batch optimization O(N)→O(1)",
    "flexibility (permanent/expiring, EXCUSED exceptions, subgroups, debt submission)",
    "full typing",
    "reactive UI"
  ]
}